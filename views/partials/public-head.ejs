<!doctype html>
<html lang="<%= lang === 'en' ? 'en' : 'pt-PT' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %><%= site.business_name %> — <%= site.business_subtitle %></title>
  <% const desc = (lang === 'en' && site.tagline_en) || site.tagline; const pageTitle = (typeof title !== 'undefined' ? title + ' · ' : '') + site.business_name + ' — ' + site.business_subtitle; %>
  <meta name="description" content="<%= desc %>">
  <link rel="canonical" href="<%= canonical %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= site.business_name %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= desc %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:image" content="<%= baseUrl %>/static/og.png">
  <meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
  <meta property="og:locale" content="<%= lang === 'en' ? 'en_GB' : 'pt_PT' %>">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/static/pwa/icon-192.png" type="image/png">
  <% if (site.lang_en === '1') { %><link rel="alternate" hreflang="pt" href="<%= canonical %>?lang=pt"><link rel="alternate" hreflang="en" href="<%= canonical %>?lang=en"><% } %>
  <% if (typeof jsonLd !== 'undefined') { %><script type="application/ld+json" nonce="<%= nonce %>"><%- JSON.stringify(jsonLd).replace(/</g, '\\u003c') %></script><% } %>
  <meta name="theme-color" content="#12171d">
  <link rel="preload" href="/static/fonts/big-shoulders-display-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/static/fonts/barlow-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/static/css/tokens.css">
  <% if (brandCss) { %><style><%- brandCss %></style><% } %>
  <link rel="stylesheet" href="/static/css/site.css">
  <link rel="stylesheet" href="/static/css/picker.css">
  <script nonce="<%= nonce %>">document.documentElement.classList.add('js')</script>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<a class="skip" href="#conteudo">Saltar para o conteúdo</a>
<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="mark" href="/" aria-label="<%= site.business_name %> — início">
      <% if (site.brand_logo) { %><img class="mark-logo" src="<%= site.brand_logo %>" alt="" width="32" height="32"><% } else { %><span class="mark-plate" aria-hidden="true"><%= site.business_name.trim()[0] %></span><% } %>
      <span class="mark-name"><%= site.business_name %></span>
    </a>
    <nav class="topnav" aria-label="Principal">
      <a href="/#servicos">Serviços</a>
      <a href="/#equipa">Equipa</a>
      <a href="/#visita">Horário e contactos</a>
      <a class="btn btn-signal btn-sm" href="/marcar">Marcar</a>
    </nav>
    <a class="btn btn-signal btn-sm top-book" href="/marcar">Marcar</a>
    <details class="menu">
      <summary aria-label="Abrir menu"><%- include('icon', { name: 'menu', size: 22 }) %></summary>
      <div class="menu-sheet">
        <a href="/#servicos">Serviços</a>
        <a href="/#equipa">Equipa</a>
        <a href="/#visita">Horário e contactos</a>
        <a href="/#perguntas">Perguntas frequentes</a>
        <a class="btn btn-signal" href="/marcar">Marcar <%- include('icon', { name: 'arrow' }) %></a>
      </div>
    </details>
  </div>
</header>

  </main>
</div>
<%
  const tabs = [['/admin', 'Hoje', 'home'], ['/admin/agenda', 'Agenda', 'calendar'], ['/admin/marcacoes', 'Marcações', 'list', pendingCount], ['/admin/mensagens', 'Mensagens', 'inbox', unread]];
  const isAct = (href) => href === '/admin' ? (path === '/admin' || path === '/admin/') : path.startsWith(href);
  const more = [['/admin/clientes', 'Clientes'], ['/admin/servicos', 'Serviços'], ['/admin/equipa', 'Equipa'], ['/admin/horario', 'Horário'], ['/admin/bloqueios', 'Férias e bloqueios'], ['/admin/definicoes', 'Definições']];
  const moreOn = more.some(([h]) => isAct(h));
%>
<% if (!path.startsWith('/admin/marcacoes/nova')) { %>
<a class="fab" href="/admin/marcacoes/nova" aria-label="Nova marcação"><%- include('icon', { name: 'plus', size: 26 }) %></a>
<% } %>
<nav class="tabbar" aria-label="Navegação principal">
  <% tabs.forEach(([href, label, icon, n]) => { %>
    <a href="<%= href %>" class="<%= isAct(href) ? 'active' : '' %>" <%- isAct(href) ? 'aria-current="page"' : '' %>><%- include('icon', { name: icon, size: 22 }) %><span><%= label %></span><% if (n) { %><b class="count"><%= n %></b><% } %></a>
  <% }) %>
  <details class="tab-more <%= moreOn ? 'active' : '' %>">
    <summary><%- include('icon', { name: 'more', size: 22 }) %><span>Mais</span></summary>
    <div class="more-sheet">
      <% more.forEach(([href, label]) => { %><a href="<%= href %>" class="<%= isAct(href) ? 'active' : '' %>"><%= label %></a><% }) %>
      <button type="button" class="linkbtn install-app" hidden>Instalar app no telemóvel</button>
      <a href="/" target="_blank" rel="noopener">Ver site</a>
      <form method="post" action="/admin/logout"><button class="linkbtn">Sair</button></form>
    </div>
  </details>
</nav>
<script>
  if ('serviceWorker' in navigator) navigator.serviceWorker.register('/admin/sw.js', { scope: '/admin' }).catch(function () {});
  var installEvt = null;
  window.addEventListener('beforeinstallprompt', function (e) {
    e.preventDefault(); installEvt = e;
    document.querySelectorAll('.install-app').forEach(function (b) { b.hidden = false; });
  });
  document.querySelectorAll('.install-app').forEach(function (b) {
    b.addEventListener('click', function () { if (!installEvt) return; installEvt.prompt(); installEvt.userChoice.finally(function () { installEvt = null; document.querySelectorAll('.install-app').forEach(function (x) { x.hidden = true; }); }); });
  });
  document.querySelectorAll('.tab-more').forEach(function (d) {
    document.addEventListener('click', function (e) { if (d.open && !d.contains(e.target)) d.open = false; });
  });
</script>
</body>
</html>

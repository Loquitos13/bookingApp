<!doctype html>
<html lang="pt-PT">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#12171d">
  <title><%= title %> · Back office · <%= site.business_name %></title>
  <link rel="preload" href="/static/fonts/barlow-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/static/css/admin.css">
</head>
<body>
<%
  const nav = [
    ['/admin', 'Hoje', 'home'], ['/admin/agenda', 'Agenda', 'calendar'], ['/admin/marcacoes', 'Marcações', 'list', pendingCount],
    ['/admin/servicos', 'Serviços', 'grid'], ['/admin/equipa', 'Equipa', 'user'], ['/admin/horario', 'Horário', 'clock'],
    ['/admin/bloqueios', 'Férias e bloqueios', 'close'], ['/admin/mensagens', 'Mensagens', 'inbox', unread], ['/admin/definicoes', 'Definições', 'more'] ];
  const isActive = (href) => href === '/admin' ? (path === '/admin' || path === '/admin/') : path.startsWith(href);
  const tabs = ['/admin', '/admin/agenda', '/admin/marcacoes', '/admin/mensagens'];
  const moreActive = !tabs.some(isActive);
%>
<a class="skip" href="#main">Saltar para o conteúdo</a>
<div class="shell">
  <aside class="side" aria-label="Navegação">
    <a class="side-brand" href="/admin"><span class="mark"><%= site.business_name.trim()[0] %></span><%= site.business_name %></a>
    <nav>
      <% nav.forEach(([href, label, icon, n]) => { %>
        <a href="<%= href %>" class="<%= isActive(href) ? 'active' : '' %>" <%- isActive(href) ? 'aria-current="page"' : '' %>><%- include('icon', { name: icon, size: 18 }) %><span><%= label %></span><% if (n) { %><span class="count"><%= n %></span><% } %></a>
      <% }) %>
    </nav>
    <div class="side-foot">
      <a href="/" target="_blank" rel="noopener"><%- include('icon', { name: 'external', size: 16 }) %> Ver site</a>
      <form method="post" action="/admin/logout"><button class="linkbtn">Sair (<%= user.name %>)</button></form>
    </div>
  </aside>
  <main class="main" id="main">
    <% if (site.demo_mode === '1') { %><p class="demo-strip">Modo demonstração: clientes e marcações são fictícios.</p><% } %>
    <% if (flash) { %><div class="flash" role="status"><%- include('icon', { name: 'check', size: 18 }) %> <%= flash %></div><% } %>

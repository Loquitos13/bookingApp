<!doctype html>
<html lang="pt-PT">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#12171d">
  <title><%= title %> · Back office · <%= site.business_name %></title>
  <link rel="preload" href="/static/fonts/barlow-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="manifest" href="/admin/manifest.webmanifest">
  <link rel="apple-touch-icon" href="/static/pwa/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="stylesheet" href="/static/css/tokens.css">
  <% if (brandCss) { %><style><%- brandCss %></style><% } %>
  <link rel="stylesheet" href="/static/css/admin.css">
</head>
<body>
<%
  const nav = [
    ['/admin', 'Hoje', 'home'], ['/admin/agenda', 'Agenda', 'calendar'], ['/admin/marcacoes', 'Marcações', 'list', pendingCount], ['/admin/clientes', 'Clientes', 'users'], ['/admin/estatisticas', 'Estatísticas', 'chart'],
    ['/admin/servicos', 'Serviços', 'tag'], ['/admin/equipa', 'Equipa', 'user'], ['/admin/horario', 'Horário', 'clock'],
    ['/admin/bloqueios', 'Férias e bloqueios', 'ban'], ['/admin/mensagens', 'Mensagens', 'inbox', unread], ['/admin/definicoes', 'Definições', 'sliders'] ];
  const OWNER_ONLY = ['/admin/definicoes', '/admin/servicos', '/admin/equipa', '/admin/horario', '/admin/estatisticas'];
  const STAFF_OK = ['/admin', '/admin/agenda', '/admin/marcacoes'];
  const canSee = (href) => role === 'owner' || (role === 'reception' ? !OWNER_ONLY.includes(href) : STAFF_OK.includes(href));
  const isActive = (href) => href === '/admin' ? (path === '/admin' || path === '/admin/') : path.startsWith(href);
  const tabs = ['/admin', '/admin/agenda', '/admin/marcacoes', '/admin/mensagens'];
  const moreActive = !tabs.some(isActive);
%>
<a class="skip" href="#main">Saltar para o conteúdo</a>
<div class="shell">
  <aside class="side" aria-label="Navegação">
    <a class="side-brand" href="/admin"><% if (site.brand_logo) { %><img class="mark mark-img" src="<%= site.brand_logo %>" alt=""><% } else { %><span class="mark"><%= site.business_name.trim()[0] %></span><% } %><%= site.business_name %></a>
    <nav>
      <% nav.filter(([href]) => canSee(href)).forEach(([href, label, icon, n]) => { %>
        <a href="<%= href %>" class="<%= isActive(href) ? 'active' : '' %>" <%- isActive(href) ? 'aria-current="page"' : '' %>><%- include('icon', { name: icon, size: 18 }) %><span><%= label %></span><% if (n) { %><span class="count"><%= n %></span><% } %></a>
      <% }) %>
    </nav>
    <div class="side-foot">
      <button type="button" class="linkbtn install-app" hidden><%- include('icon', { name: 'plus', size: 16 }) %> Instalar app</button>
      <a href="/" target="_blank" rel="noopener"><%- include('icon', { name: 'external', size: 16 }) %> Ver site</a>
      <a href="/admin/conta"><%- include('icon', { name: 'user', size: 16 }) %> <%= user.name %> · <%= ROLE_LABEL[role] %></a>
      <form method="post" action="/admin/logout"><button class="linkbtn">Sair</button></form>
    </div>
  </aside>
  <main class="main" id="main">
    <% if (site.demo_mode === '1') { %><p class="demo-strip">Modo demonstração: clientes e marcações são fictícios</p><% } %>
    <% if (flash) { %><div class="flash" role="status"><%- include('icon', { name: 'check', size: 18 }) %> <%= flash %></div><% } %>

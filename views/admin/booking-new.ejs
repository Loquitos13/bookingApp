<%- include('../partials/admin-head', { title: 'Nova marcação' }) %>
<header class="head"><h1>Nova marcação</h1><a href="/admin/marcacoes">← Voltar</a></header>
<% if (error) { %><p class="alert"><%= error %></p><% } %>
<form method="post" action="/admin/marcacoes" class="panel form-grid" id="new-booking">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Serviço<select name="serviceId" required>
    <option value="">— escolher —</option>
    <% services.forEach(s => { %><option value="<%= s.id %>" <%= String(form.serviceId) === String(s.id) ? 'selected' : '' %>><%= s.name %> (<%= s.duration_min %> min)<%= s.active ? '' : ' — inativo' %></option><% }) %>
  </select></label>
  <label>Profissional<select name="staffId">
    <option value="">Qualquer disponível</option>
    <% staff.forEach(p => { %><option value="<%= p.id %>" <%= String(form.staffId) === String(p.id) ? 'selected' : '' %>><%= p.name %></option><% }) %>
  </select></label>
  <label>Data<input type="date" name="date" value="<%= form.date %>" required></label>
  <label>Hora<input name="time" value="<%= form.time %>" placeholder="HH:MM" pattern="\d{1,2}:\d{2}" required list="slot-list" autocomplete="off">
    <datalist id="slot-list"></datalist><small class="muted" id="slot-hint"></small></label>
  <div class="ac"><label>Nome do cliente<input name="name" value="<%= form.name || '' %>" required autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="ac-list" placeholder="Escreva para procurar clientes"></label><ul class="ac-list" id="ac-list" role="listbox" hidden></ul></div>
  <label>Telefone<input name="phone" type="tel" value="<%= form.phone && form.phone !== '—' ? form.phone : '' %>"></label>
  <label>Email<input name="email" type="email" value="<%= form.email && form.email !== '—' ? form.email : '' %>"></label>
  <label class="span2">Notas do cliente<textarea name="notes" rows="2"><%= form.notes || '' %></textarea></label>
  <label class="span2">Notas internas<textarea name="internal_notes" rows="2"><%= form.internalNotes || '' %></textarea></label>
  <fieldset class="span2 repeat">
    <legend>Repetir</legend>
    <label>Frequência<select name="repeat"><option value="">Não repetir</option><option value="semanal">Todas as semanas</option><option value="quinzenal">De 2 em 2 semanas</option></select></label>
    <label>Número de marcações (incluindo esta)<input type="number" name="repeat_count" min="1" max="26" value="1"></label>
    <p class="muted tiny">Ex.: plano de tratamento de 8 sessões. Mesmo dia da semana, mesma hora e mesmo profissional; os dias sem vaga são indicados no fim.</p>
  </fieldset>
  <label class="check"><input type="checkbox" name="notify" value="1" <%= form.notify ? 'checked' : '' %>> Enviar email de confirmação ao cliente</label>
  <label class="check"><input type="checkbox" name="force" value="1" <%= form.force ? 'checked' : '' %>> Ignorar disponibilidade (encaixe)</label>
  <div class="span2"><button class="btn">Criar marcação</button></div>
</form>
<script nonce="<%= nonce %>">
(function () {
  const f = document.getElementById('new-booking');
  const list = document.getElementById('slot-list'), hint = document.getElementById('slot-hint');
  async function refresh() {
    const s = f.serviceId.value, d = f.date.value;
    if (!s || !d) { hint.textContent = ''; return; }
    const r = await fetch(`/admin/api/slots?service=${s}&staff=${f.staffId.value}&date=${d}`).then(r => r.json());
    list.innerHTML = r.slots.map(x => `<option value="${x.time}">`).join('');
    hint.textContent = r.slots.length ? `Livres: ${r.slots.slice(0, 14).map(x => x.time).join(', ')}${r.slots.length > 14 ? '…' : ''}` : 'Sem horários livres neste dia.';
  }
  ['serviceId', 'staffId', 'date'].forEach(n => f[n].addEventListener('change', refresh));

  // autocompletar clientes existentes
  const nameIn = f.name, acl = document.getElementById('ac-list');
  let acT, acItems = [], acI = -1;
  const close = () => { acl.hidden = true; nameIn.setAttribute('aria-expanded', 'false'); acI = -1; };
  const choose = (c) => { f.name.value = c.name; f.email.value = c.email; f.phone.value = c.phone; close(); f.phone.focus(); };
  const esc = (v) => String(v ?? '').replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[ch]));
  const paint = () => { acl.innerHTML = acItems.map((c, i) => `<li><button type="button" role="option" aria-selected="${i === acI}" data-i="${i}"><strong>${esc(c.name)}</strong><small>${esc(c.phone)} · ${esc(c.email)} · ${c.visits} visitas</small></button></li>`).join(''); };
  nameIn.addEventListener('input', () => {
    clearTimeout(acT);
    acT = setTimeout(async () => {
      const q = nameIn.value.trim();
      if (q.length < 2) return close();
      acItems = (await fetch('/admin/api/clientes?q=' + encodeURIComponent(q)).then(r => r.json())).clients;
      if (!acItems.length) return close();
      acI = -1; paint(); acl.hidden = false; nameIn.setAttribute('aria-expanded', 'true');
    }, 160);
  });
  nameIn.addEventListener('keydown', (e) => {
    if (acl.hidden) return;
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); acI = (acI + (e.key === 'ArrowDown' ? 1 : -1) + acItems.length) % acItems.length; paint(); }
    else if (e.key === 'Enter' && acI >= 0) { e.preventDefault(); choose(acItems[acI]); }
    else if (e.key === 'Escape') close();
  });
  acl.addEventListener('mousedown', (e) => { const b = e.target.closest('[data-i]'); if (b) { e.preventDefault(); choose(acItems[+b.dataset.i]); } });
  nameIn.addEventListener('blur', () => setTimeout(close, 120));
  refresh();
})();
</script>
<%- include('../partials/admin-foot') %>

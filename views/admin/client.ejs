<%- include('../partials/admin-head', { title: c.name }) %>
<%
  const tel = (c.phone || '').replace(/[^\d+]/g, '');
  const wa = tel ? 'https://wa.me/' + (tel.startsWith('+') ? tel.slice(1) : (tel.length === 9 ? '351' + tel : tel)) : '';
  const newHref = '/admin/marcacoes/nova?nome=' + encodeURIComponent(c.name) + '&email=' + encodeURIComponent(c.email) + '&tel=' + encodeURIComponent(c.phone || '');
%>
<header class="head">
  <div>
    <a class="crumb" href="/admin/clientes"><%- include('../partials/icon', { name: 'back', size: 16 }) %> Clientes</a>
    <h1><%= c.name %></h1>
    <p class="muted"><%= c.email %><%= c.phone ? ' · ' + c.phone : '' %></p>
  </div>
  <a class="btn btn-signal" href="<%= newHref %>"><%- include('../partials/icon', { name: 'plus', size: 18 }) %> Nova marcação</a>
</header>

<div class="quick">
  <% if (tel) { %><a class="btn btn-ghost" href="tel:<%= tel %>"><%- include('../partials/icon', { name: 'phone', size: 18 }) %> Ligar</a><% } %>
  <% if (wa) { %><a class="btn btn-ghost" href="<%= wa %>" target="_blank" rel="noopener"><%- include('../partials/icon', { name: 'external', size: 18 }) %> WhatsApp</a><% } %>
  <a class="btn btn-ghost" href="mailto:<%= c.email %>"><%- include('../partials/icon', { name: 'mail', size: 18 }) %> Email</a>
</div>

<nav class="tally" aria-label="Resumo do cliente">
  <span><strong><%= c.visits %></strong> visitas</span>
  <span><strong><%= c.upcoming %></strong> marcadas</span>
  <span class="<%= c.no_shows ? 'is-warn' : '' %>"><strong><%= c.no_shows %></strong> faltas</span>
  <span><strong><%= t.euros(c.spent) %></strong> em sessões concluídas</span>
</nav>

<div class="grid2 grid2-wide">
  <section class="panel">
    <h2>Histórico</h2>
    <ol class="timeline">
      <% bookings.forEach(b => { %>
        <li class="tl-<%= b.status %> <%= b.date >= d && ['pending','confirmed'].includes(b.status) ? 'is-future' : '' %>">
          <a href="/admin/marcacoes/<%= b.id %>" class="row-main">
            <span class="when"><strong><%= t.minToTime(b.start_min) %></strong><small><%= t.formatDateShort(b.date) %> <%= b.date.slice(0, 4) %></small></span>
            <span class="who"><strong><%= b.service_name %></strong><small><i class="dot" style="background:<%= b.staff_color %>"></i><%= b.staff_name %><%= b.notes ? ' · “' + b.notes + '”' : '' %></small></span>
            <span class="badge badge-<%= b.status %>"><%= STATUS[b.status] %></span>
          </a>
        </li>
      <% }) %>
    </ol>
  </section>
  <form method="post" class="panel">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="email" value="<%= c.email %>">
    <h2>Notas do cliente</h2>
    <p class="muted tiny">Só visíveis na equipa. Úteis para preferências, historial clínico resumido ou avisos.</p>
    <textarea name="notes" rows="8" placeholder="Ex.: prefere o fim do dia; alergia a…"><%= notes %></textarea>
    <p></p>
    <button class="btn">Guardar notas</button>
  </form>
</div>
<section class="panel" id="pacotes">
  <h2>Pacotes</h2>
  <% if (!cpacks.length) { %><p class="empty">Sem pacotes.</p><% } %>
  <ul class="list">
    <% cpacks.forEach(cp => { const left = cp.sessions_total - cp.sessions_used; const expired = cp.expires_at && cp.expires_at < d; %>
      <li class="row">
        <span class="row-main">
          <span class="pk-meter" aria-hidden="true"><% for (let i = 0; i < cp.sessions_total; i++) { %><i class="<%= i < cp.sessions_used ? 'used' : '' %>"></i><% } %></span>
          <span class="who"><strong><%= cp.name %> · <%= left %> de <%= cp.sessions_total %> por usar</strong><small><%= cp.service_name %> · comprado <%= t.formatDateShort(cp.purchased_at) %><%= cp.expires_at ? (expired ? ' · expirou ' : ' · válido até ') + t.formatDateShort(cp.expires_at) + ' ' + cp.expires_at.slice(0, 4) : '' %><%= cp.notes ? ' · ' + cp.notes : '' %></small></span>
        </span>
        <form method="post" action="/admin/clientes/pacote" class="row-actions">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="email" value="<%= c.email %>"><input type="hidden" name="id" value="<%= cp.id %>">
          <input type="hidden" name="delta" value="1">
          <button class="btn btn-ghost btn-sm" name="action" value="adjust" title="Descontar uma sessão manualmente">−1 sessão</button>
          <button class="linkbtn danger" name="action" value="remove" data-confirm="Remover este pacote do cliente?">Remover</button>
        </form>
      </li>
    <% }) %>
  </ul>
  <% if (packages.length) { %>
  <form method="post" action="/admin/clientes/pacote" class="pk-assign">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="email" value="<%= c.email %>">
    <label>Atribuir pacote<select name="package_id"><% packages.forEach(p => { %><option value="<%= p.id %>"><%= p.name %> · <%= p.service_name %> · <%= t.euros(p.price_cents) %></option><% }) %></select></label>
    <label>Nota (ex.: pago em numerário)<input name="notes" maxlength="300"></label>
    <button class="btn">Atribuir</button>
  </form>
  <% } %>
</section>

<details class="panel danger-panel">
  <summary><h2>Dados pessoais (RGPD)</h2></summary>
  <p class="muted">A pedido do cliente: exportar tudo o que guardamos, ou apagar os dados pessoais. Ao apagar, as marcações ficam anónimas (contam nas estatísticas, sem nome nem contactos). Não é reversível.</p>
  <div class="row-actions">
    <a class="btn btn-ghost" href="/admin/clientes/exportar?email=<%= encodeURIComponent(c.email) %>">Exportar dados (JSON)</a>
  </div>
  <form method="post" action="/admin/clientes/apagar" class="form-grid erase" data-confirm="Apagar definitivamente os dados pessoais de <%= c.name %>?">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="email" value="<%= c.email %>">
    <label>Para confirmar, escreva o email do cliente<input name="confirm" autocomplete="off" placeholder="<%= c.email %>"></label>
    <div><button class="btn btn-danger">Apagar dados pessoais</button></div>
  </form>
</details>
<%- include('../partials/admin-foot') %>

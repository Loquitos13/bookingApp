<%- include('../partials/admin-head', { title: 'Serviços' }) %>
<header class="head"><div><h1>Serviços</h1><p class="muted">O que os clientes podem marcar no site. A duração define o tamanho de cada marcação.</p></div></header>

<% const fields = (s) => { %>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label class="span2">Nome<input name="name" value="<%= s.name || '' %>" required></label>
  <label>Duração (min)<input type="number" name="duration_min" min="5" max="600" step="5" value="<%= s.duration_min || 45 %>" required></label>
  <label>Preço (€)<input name="price" inputmode="decimal" value="<%= s.price_cents != null ? (s.price_cents / 100).toFixed(2).replace('.', ',') : '' %>"></label>
  <label class="span2">Descrição<textarea name="description" rows="2"><%= s.description || '' %></textarea></label>
  <label>Ordem<input type="number" name="sort" value="<%= s.sort || 0 %>"></label>
  <label class="check"><input type="checkbox" name="active" value="1" <%= s.active !== 0 ? 'checked' : '' %>> Visível no site</label>
<% } %>

<div class="cards">
  <% services.forEach(s => { %>
    <form method="post" action="/admin/servicos/<%= s.id %>" class="panel form-grid <%= s.active ? '' : 'inactive' %>">
      <% fields(s) %>
      <div class="span2 row-actions">
        <button class="btn">Guardar</button>
        <span class="muted tiny"><%= s.uses %> marcações</span>
        <button class="linkbtn danger" name="action" value="delete" data-confirm="Apagar este serviço?">Apagar</button>
      </div>
    </form>
  <% }) %>
  <form method="post" action="/admin/servicos" class="panel form-grid new">
    <h3 class="span2">Novo serviço</h3>
    <% fields({}) %>
    <div class="span2"><button class="btn">Adicionar serviço</button></div>
  </form>
</div>
<section class="panel" id="pacotes">
  <h2>Pacotes de sessões</h2>
  <p class="muted">Ex.: 10 sessões com desconto. Vendem-se no balcão e atribuem-se na ficha do cliente; cada marcação concluída desse serviço desconta uma sessão. Aparecem no site junto ao serviço.</p>
  <div class="table-wrap">
  <table class="table pk-table">
    <thead><tr><th>Nome</th><th>Serviço</th><th>Sessões</th><th>Preço (€)</th><th>Validade (dias)</th><th>Ativo</th><th></th></tr></thead>
    <tbody>
      <% packages.forEach(p => { %>
        <tr>
          <td colspan="7">
            <form method="post" action="/admin/pacotes/<%= p.id %>" class="pk-row">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input name="name" value="<%= p.name %>" aria-label="Nome" required>
              <select name="service_id" aria-label="Serviço"><% services.forEach(s => { %><option value="<%= s.id %>" <%= s.id === p.service_id ? 'selected' : '' %>><%= s.name %></option><% }) %></select>
              <input type="number" name="sessions" min="1" max="100" value="<%= p.sessions %>" aria-label="Sessões">
              <input name="price" inputmode="decimal" value="<%= (p.price_cents / 100).toFixed(2).replace('.', ',') %>" aria-label="Preço">
              <input type="number" name="validity_days" min="1" value="<%= p.validity_days %>" aria-label="Validade em dias">
              <label class="check"><input type="checkbox" name="active" value="1" <%= p.active ? 'checked' : '' %>> <span class="sr-only">Ativo</span></label>
              <span class="row-actions"><button class="btn btn-sm">Guardar</button><button class="linkbtn danger" name="action" value="delete" data-confirm="Apagar este pacote?">Apagar</button><span class="muted tiny"><%= p.sold %> vendidos</span></span>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
  <form method="post" action="/admin/pacotes" class="pk-row pk-new">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input name="name" placeholder="Ex.: Pack 5 massagens" aria-label="Nome do novo pacote" required>
    <select name="service_id" aria-label="Serviço"><% services.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select>
    <input type="number" name="sessions" min="1" max="100" value="5" aria-label="Sessões">
    <input name="price" inputmode="decimal" placeholder="Preço" aria-label="Preço">
    <input type="number" name="validity_days" min="1" value="365" aria-label="Validade em dias">
    <input type="hidden" name="active" value="1">
    <button class="btn btn-sm">Adicionar pacote</button>
  </form>
</section>
<%- include('../partials/admin-foot') %>

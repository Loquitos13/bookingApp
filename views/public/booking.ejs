<%- include('../partials/public-head', { title: 'A sua marcação', bodyClass: 'page-ticket' }) %>
<%
  const STATUS = { pending: 'Por confirmar', confirmed: 'Confirmada', completed: 'Concluída', cancelled: 'Cancelada', no_show: 'Falta' };
  const stamp = (d, m) => d.replace(/-/g, '') + 'T' + t.minToTime(m).replace(':', '') + '00';
  const gcal = 'https://calendar.google.com/calendar/render?action=TEMPLATE'
    + '&text=' + encodeURIComponent(b.service_name + ' · ' + site.business_name)
    + '&dates=' + stamp(b.date, b.start_min) + '/' + stamp(b.date, b.end_min)
    + '&ctz=' + encodeURIComponent(site.timezone)
    + '&location=' + encodeURIComponent(site.address)
    + '&details=' + encodeURIComponent('Com ' + b.staff_name + '. Referência ' + b.ref + '.');
  const maps = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(site.address);
  const live = ['pending', 'confirmed'].includes(b.status);
%>
<main id="conteudo" class="ticket-page">
  <div class="wrap narrow">
    <% if (isNew) { %>
      <h1 class="ticket-h"><%= b.status === 'pending' ? 'Pedido recebido' : 'Está marcado' %></h1>
      <p class="lead"><%= b.status === 'pending' ? 'Vamos confirmar e avisamos por email.' : 'Enviámos o bilhete para' %> <strong><%= b.customer_email %></strong>.</p>
    <% } else { %>
      <h1 class="ticket-h">A sua marcação</h1>
    <% } %>
    <% if (cancelled && b.status === 'cancelled') { %><p class="notice notice-ok" role="status"><%- include('../partials/icon', { name: 'check' }) %> A marcação foi cancelada.</p><% } %>
    <% if (cancelled && b.status !== 'cancelled') { %><p class="notice notice-err" role="alert">Já não é possível cancelar online. Ligue para <a href="tel:<%= site.phone.replace(/\s/g,'') %>"><%= site.phone %></a>.</p><% } %>

    <article class="ticket <%= isNew ? 'is-new' : '' %> st-<%= b.status %>" aria-label="Bilhete da marcação">
      <div class="ticket-main">
        <p class="ticket-biz"><%= site.business_name %> <span><%= site.business_subtitle %></span></p>
        <div class="ticket-time">
          <%- include('../partials/flap', { text: t.minToTime(b.start_min) }) %>
          <span class="ticket-date"><%= t.formatDateLong(b.date) %></span>
        </div>
        <dl class="ticket-facts">
          <div><dt>Serviço</dt><dd><%= b.service_name %></dd></div>
          <div><dt>Com</dt><dd><%= b.staff_name %></dd></div>
          <div><dt>Duração</dt><dd><%= b.duration_min %> min · até <%= t.minToTime(b.end_min) %></dd></div>
          <div><dt>Preço</dt><dd><%= t.euros(b.price_cents) %></dd></div>
        </dl>
      </div>
      <div class="ticket-stub">
        <span class="ticket-state"><%= STATUS[b.status] %></span>
        <span class="ticket-ref"><span>Ref.</span> <%= b.ref %></span>
      </div>
    </article>

    <% if (live) { %>
    <div class="ticket-actions">
      <a class="action" href="/marcacao/<%= b.token %>.ics"><%- include('../partials/icon', { name: 'calendar' }) %><span>Adicionar ao calendário</span></a>
      <a class="action" href="<%= gcal %>" target="_blank" rel="noopener"><%- include('../partials/icon', { name: 'external' }) %><span>Google Calendar</span></a>
      <a class="action" href="<%= maps %>" target="_blank" rel="noopener"><%- include('../partials/icon', { name: 'pin' }) %><span>Como chegar</span></a>
      <button type="button" class="action" data-share data-title="<%= b.service_name %> · <%= site.business_name %>" data-text="<%= t.formatDateLong(b.date) %> às <%= t.minToTime(b.start_min) %>" hidden><%- include('../partials/icon', { name: 'share' }) %><span>Partilhar</span></button>
    </div>
    <% } %>

    <div class="ticket-manage">
      <% if (canCancel) { %>
        <form method="post" action="/marcacao/<%= b.token %>/cancelar" id="cancel-form">
          <button type="button" class="link-btn link-danger" data-open="cancel-dialog">Cancelar esta marcação</button>
          <dialog id="cancel-dialog" class="sheet" aria-labelledby="cancel-title">
            <h2 id="cancel-title">Cancelar a marcação?</h2>
            <p><%= b.service_name %>, <%= t.formatDateLong(b.date).toLowerCase() %> às <%= t.minToTime(b.start_min) %>. O horário fica livre para outra pessoa.</p>
            <div class="sheet-actions">
              <button class="btn btn-danger btn-block">Sim, cancelar</button>
              <button type="button" class="btn btn-ghost btn-block" data-close>Manter marcação</button>
            </div>
          </dialog>
          <noscript><button class="btn btn-danger">Cancelar marcação</button></noscript>
        </form>
      <% } else if (live) { %>
        <p class="muted">Para alterar ou cancelar a menos de <%= site.cancel_hours %>h, ligue para <a href="tel:<%= site.phone.replace(/\s/g,'') %>"><%= site.phone %></a>.</p>
      <% } %>
      <a class="btn btn-ink" href="/marcar">Fazer outra marcação</a>
    </div>
    <p class="fine">Este link é pessoal: guarde-o para gerir a marcação.</p>
  </div>
</main>
<%- include('../partials/public-foot', { bottomBar: false }) %>

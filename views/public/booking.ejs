<%- include('../partials/public-head', { title: L('tk.title'), bodyClass: 'page-ticket' }) %>
<%
  const STATUS = { pending: L('st.pending'), confirmed: L('st.confirmed'), completed: L('st.completed'), cancelled: L('st.cancelled'), no_show: L('st.no_show') };
  const stamp = (d, m) => d.replace(/-/g, '') + 'T' + t.minToTime(m).replace(':', '') + '00';
  const gcal = 'https://calendar.google.com/calendar/render?action=TEMPLATE'
    + '&text=' + encodeURIComponent(b.service_name + ' · ' + site.business_name)
    + '&dates=' + stamp(b.date, b.start_min) + '/' + stamp(b.date, b.end_min)
    + '&ctz=' + encodeURIComponent(site.timezone)
    + '&location=' + encodeURIComponent(site.address)
    + '&details=' + encodeURIComponent('Com ' + b.staff_name + '. Referência ' + b.ref + '.');
  const maps = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(site.address);
  const live = ['pending', 'confirmed'].includes(b.status);
%>
<main id="conteudo" class="ticket-page">
  <div class="wrap narrow">
    <% if (isNew) { %>
      <h1 class="ticket-h"><%= b.payment_status === 'pending' ? L('tk.payfirst') : b.status === 'pending' ? L('tk.received') : L('tk.booked') %></h1>
      <p class="lead"><%= b.payment_status === 'pending' ? L('tk.payto') : b.status === 'pending' ? L('tk.willconfirm') : L('tk.sentto') %> <strong><%= b.customer_email %></strong>.</p>
    <% } else { %>
      <h1 class="ticket-h"><%= L('tk.title') %></h1>
    <% } %>
    <% if (b.payment_status === 'pending' && b.status !== 'cancelled') { %>
      <div class="pay-box" role="status">
        <p><strong><%= L('pay.needed', { amount: t.euros(b.deposit_cents) }) %></strong> <%= L('pay.hold', { min: site.payment_timeout_min }) %></p>
        <% if (payState === 'erro') { %><p class="muted"><%= L('pay.error') %></p><% } %>
        <form method="post" action="/marcacao/<%= b.token %>/pagar"><button class="btn btn-signal btn-lg"><%= L('pay.cta', { amount: t.euros(b.deposit_cents) }) %></button></form>
        <p class="muted tiny"><%= L('pay.methods') %></p>
      </div>
    <% } else if (b.payment_status === 'processing') { %>
      <p class="notice notice-ok" role="status"><%= L('pay.processing') %></p>
    <% } else if (b.payment_status === 'paid' && payState === '1') { %>
      <p class="notice notice-ok" role="status"><%- include('../partials/icon', { name: 'check' }) %> <%= L('pay.done', { amount: t.euros(b.deposit_cents) }) %></p>
    <% } else if (payState === '1') { %>
      <p class="notice notice-ok" role="status"><%= L('pay.checking') %></p>
    <% } %>
    <% if (moved) { %><p class="notice notice-ok" role="status"><%- include('../partials/icon', { name: 'check' }) %> <%= L('tk.moved') %></p><% } %>
    <% if (cancelled && b.status === 'cancelled') { %><p class="notice notice-ok" role="status"><%- include('../partials/icon', { name: 'check' }) %> <%= L('tk.cancelled') %></p><% } %>
    <% if (cancelled && b.status !== 'cancelled') { %><p class="notice notice-err" role="alert"><%= L('tk.toolate') %> <a href="tel:<%= site.phone.replace(/\s/g,'') %>"><%= site.phone %></a>.</p><% } %>

    <article class="ticket <%= isNew ? 'is-new' : '' %> st-<%= b.status %>" aria-label="<%= L('tk.ticket') %>">
      <div class="ticket-main">
        <p class="ticket-biz"><%= site.business_name %> <span><%= site.business_subtitle %></span></p>
        <div class="ticket-time">
          <%- include('../partials/flap', { text: t.minToTime(b.start_min) }) %>
          <span class="ticket-date"><%= t.formatDateLong(b.date) %></span>
        </div>
        <dl class="ticket-facts">
          <div><dt><%= L('tk.service') %></dt><dd><%= b.service_name %></dd></div>
          <div><dt><%= L('tk.with') %></dt><dd><%= b.staff_name %></dd></div>
          <div><dt><%= L('tk.duration') %></dt><dd><%= b.duration_min %> min · <%= L('tk.until') %> <%= t.minToTime(b.end_min) %></dd></div>
          <div><dt><%= L('tk.price') %></dt><dd><%= t.euros(b.price_cents) %><%= b.payment_status === 'paid' ? ' · ' + L('pay.paidShort', { amount: t.euros(b.deposit_cents) }) : '' %></dd></div>
        </dl>
      </div>
      <div class="ticket-stub">
        <span class="ticket-state"><%= STATUS[b.status] %></span>
        <span class="ticket-ref"><span><%= L('tk.ref') %></span> <%= b.ref %></span>
      </div>
    </article>

    <% if (live) { %>
    <div class="ticket-actions">
      <a class="action" href="/marcacao/<%= b.token %>.ics"><%- include('../partials/icon', { name: 'calendar' }) %><span><%= L('tk.addcal') %></span><%- include('../partials/icon', { name: 'arrow', size: 18, cls: 'action-go' }) %></a>
      <a class="action" href="<%= gcal %>" target="_blank" rel="noopener"><%- include('../partials/icon', { name: 'external' }) %><span>Google Calendar</span><%- include('../partials/icon', { name: 'arrow', size: 18, cls: 'action-go' }) %></a>
      <a class="action" href="<%= maps %>" target="_blank" rel="noopener"><%- include('../partials/icon', { name: 'pin' }) %><span><%= L('tk.directions') %></span><%- include('../partials/icon', { name: 'arrow', size: 18, cls: 'action-go' }) %></a>
      <button type="button" class="action" data-share data-title="<%= b.service_name %> · <%= site.business_name %>" data-text="<%= t.formatDateLong(b.date) %> <%= L('tk.at') %> <%= t.minToTime(b.start_min) %>" hidden><%- include('../partials/icon', { name: 'share' }) %><span><%= L('tk.share') %></span><%- include('../partials/icon', { name: 'arrow', size: 18, cls: 'action-go' }) %></button>
    </div>
    <% } %>

    <div class="ticket-manage">
      <% if (canCancel) { %>
        <a class="btn btn-signal" href="/marcacao/<%= b.token %>/reagendar"><%- include('../partials/icon', { name: 'calendar', size: 18 }) %> <%= L('tk.change') %></a>
        <form method="post" action="/marcacao/<%= b.token %>/cancelar" id="cancel-form">
          <button type="button" class="link-btn link-danger" data-open="cancel-dialog"><%= L('tk.cancel') %></button>
          <dialog id="cancel-dialog" class="sheet" aria-labelledby="cancel-title">
            <h2 id="cancel-title"><%= L('tk.cancelq') %></h2>
            <p><%= b.service_name %>, <%= t.formatDateLong(b.date) %> <%= L('tk.at') %> <%= t.minToTime(b.start_min) %>. <%= L('tk.freed') %></p>
            <div class="sheet-actions">
              <button class="btn btn-danger btn-block"><%= L('tk.yes') %></button>
              <button type="button" class="btn btn-ghost btn-block" data-close><%= L('tk.keep') %></button>
            </div>
          </dialog>
          <noscript><button class="btn btn-danger"><%= L('tk.cancelbtn') %></button></noscript>
        </form>
      <% } else if (live) { %>
        <p class="muted"><%= L('tk.late', { h: site.cancel_hours }) %> <a href="tel:<%= site.phone.replace(/\s/g,'') %>"><%= site.phone %></a>.</p>
      <% } %>
      <a class="btn btn-ink" href="/marcar"><%= L('tk.another') %></a>
    </div>
    <p class="fine"><%= L('tk.personal') %></p>
  </div>
</main>
<%- include('../partials/public-foot', { bottomBar: false }) %>
